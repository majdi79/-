rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFundId(id) {
      return id is string && id.size() >= 6 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMonthKey(val) {
      return val is string && val.size() == 7 && val.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function isValidDateStr(val) {
      return val is string && val.size() <= 10 && val.matches('^(|[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$');
    }

    function isValidPhone(val) {
      return val is string && val.size() <= 24 && val.matches('^[0-9+\\-\\s()]{0,24}$');
    }

    function fundExists(fundId) {
      return exists(/databases/$(database)/documents/funds/$(fundId));
    }

    function memberExistsAfter(fundId, memberId) {
      return existsAfter(/databases/$(database)/documents/funds/$(fundId)/members/$(memberId));
    }

    // Validation Blueprint: FamilyFund
    function isValidFund(data, fundId) {
      return data.keys().hasAll(['fundId', 'fundName', 'currency', 'reminderTemplate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fundId', 'fundName', 'currency', 'reminderTemplate', 'createdAt', 'updatedAt'])
        && isValidFundId(data.fundId)
        && data.fundId == fundId
        && data.fundName is string
        && data.fundName.size() >= 1
        && data.fundName.size() <= 80
        && data.currency is string
        && data.currency.size() >= 1
        && data.currency.size() <= 12
        && data.reminderTemplate is string
        && data.reminderTemplate.size() >= 1
        && data.reminderTemplate.size() <= 600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: FamilyMember
    function isValidMember(data, fundId) {
      return data.keys().hasAll(['fundId', 'name', 'phone', 'relation', 'monthlyAmount', 'startMonth', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fundId', 'name', 'phone', 'relation', 'monthlyAmount', 'startMonth', 'isActive', 'createdAt', 'updatedAt'])
        && isValidFundId(data.fundId)
        && data.fundId == fundId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && isValidPhone(data.phone)
        && data.relation is string
        && data.relation.size() <= 40
        && (data.monthlyAmount is int || data.monthlyAmount is float)
        && data.monthlyAmount >= 0
        && data.monthlyAmount <= 1000000
        && isValidMonthKey(data.startMonth)
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: MonthlyPayment
    function isValidPayment(data, fundId) {
      return data.keys().hasAll(['fundId', 'memberId', 'monthKey', 'expectedAmount', 'paidAmount', 'status', 'paidDate', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fundId', 'memberId', 'monthKey', 'expectedAmount', 'paidAmount', 'status', 'paidDate', 'note', 'lastRemindedAt', 'createdAt', 'updatedAt'])
        && isValidFundId(data.fundId)
        && data.fundId == fundId
        && isValidId(data.memberId)
        && isValidMonthKey(data.monthKey)
        && (data.expectedAmount is int || data.expectedAmount is float)
        && data.expectedAmount >= 0
        && data.expectedAmount <= 1000000
        && (data.paidAmount is int || data.paidAmount is float)
        && data.paidAmount >= 0
        && data.paidAmount <= 1000000
        && data.status in ['paid', 'partial', 'unpaid']
        && isValidDateStr(data.paidDate)
        && data.note is string
        && data.note.size() <= 160
        && (!('lastRemindedAt' in data) || data.lastRemindedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Family Fund Workspace Document (No top-level listing to prevent enumeration)
    match /funds/{fundId} {
      allow get: if isValidFundId(fundId);
      allow list: if false;
      allow create: if isValidFundId(fundId)
        && isValidFund(incoming(), fundId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidFundId(fundId)
        && isValidFund(incoming(), fundId)
        && incoming().fundId == existing().fundId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['fundName', 'currency', 'reminderTemplate', 'updatedAt'])
        );
      allow delete: if false;

      // Subcollection: Family Members
      match /members/{memberId} {
        allow get: if isValidFundId(fundId) && isValidId(memberId) && fundExists(fundId);
        allow list: if isValidFundId(fundId) && resource.data.fundId == fundId;
        allow create: if isValidFundId(fundId)
          && isValidId(memberId)
          && isValidMember(incoming(), fundId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && fundExists(fundId);
        allow update: if isValidFundId(fundId)
          && isValidId(memberId)
          && isValidMember(incoming(), fundId)
          && incoming().fundId == existing().fundId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Edit member profile details
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'relation', 'monthlyAmount', 'startMonth', 'isActive', 'updatedAt'])
            ||
            // Action: Toggle active status only
            incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt'])
          )
          && fundExists(fundId);
        allow delete: if isValidFundId(fundId) && isValidId(memberId) && fundExists(fundId);
      }

      // Subcollection: Monthly Payments (Master Gate + Member Atomicity Invariant)
      match /payments/{paymentId} {
        allow get: if isValidFundId(fundId) && isValidId(paymentId) && fundExists(fundId);
        allow list: if isValidFundId(fundId) && resource.data.fundId == fundId;
        allow create: if isValidFundId(fundId)
          && isValidId(paymentId)
          && isValidPayment(incoming(), fundId)
          && paymentId == incoming().memberId + '_' + incoming().monthKey
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (!('lastRemindedAt' in incoming()) || incoming().lastRemindedAt == request.time)
          && fundExists(fundId)
          && memberExistsAfter(fundId, incoming().memberId);
        allow update: if isValidFundId(fundId)
          && isValidId(paymentId)
          && isValidPayment(incoming(), fundId)
          && incoming().fundId == existing().fundId
          && incoming().memberId == existing().memberId
          && incoming().monthKey == existing().monthKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Record or adjust monthly payment
            incoming().diff(existing()).affectedKeys().hasOnly(['expectedAmount', 'paidAmount', 'status', 'paidDate', 'note', 'updatedAt'])
            ||
            // Action: Log WhatsApp reminder timestamp
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['lastRemindedAt', 'updatedAt'])
              && incoming().lastRemindedAt == request.time
            )
          )
          && fundExists(fundId);
        allow delete: if isValidFundId(fundId) && isValidId(paymentId) && fundExists(fundId);
      }
    }
  }
}
